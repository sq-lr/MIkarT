# AI_PROVIDER selects the backend implementation for VisionService/WorldSynthesisService.
# "mock" requires no credentials and is the only implementation shipped in this bootstrap.
AI_PROVIDER=mock

# Placeholders for a future real vision/LLM provider. Leave blank while AI_PROVIDER=mock.
VISION_API_KEY=
SYNTHESIS_API_KEY=

HOST=0.0.0.0
PORT=8000
