# ---- Vision (VLM) provider: extracts scene info + objects from the image ----
# mock   - deterministic canned scenes, no key, no network (default)
# claude - Claude vision (claude-opus-5) via the anthropic SDK
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# ---- Mesh provider: turns each extracted object crop into a 3D model ----
# mock  - generates nothing; Unity keeps primitive placeholders (default)
# meshy - Meshy Image-to-3D (https://docs.meshy.ai/en/api/image-to-3d)
MESH_PROVIDER=mock
MESHY_API_KEY=
# model_type must be `standard` for meshy-7.1 (it rejects `lowpoly`); the
# mesh is remeshed down to MESHY_TARGET_POLYCOUNT triangles instead.
MESHY_MODEL_TYPE=standard
MESHY_SHOULD_TEXTURE=true
MESHY_TARGET_POLYCOUNT=8000

# Upper bound on objects extracted per world. Each one is a Meshy task
# (credits + minutes of generation), so keep this small.
MAX_OBJECTS_PER_WORLD=4

# ---- Text asset provider: extracts key props named in the player's TEXT
# description that the photo may not show (e.g. "a giant floating whale") ----
# mock   - extracts nothing, no key, no network (default)
# claude - Claude text-only structured output (reuses ANTHROPIC_API_KEY above)
TEXT_ASSET_PROVIDER=mock

# Upper bound on text-extracted assets per world. Each one costs TWO Meshy
# jobs (preview + refine), so keep this smaller than MAX_OBJECTS_PER_WORLD.
MAX_TEXT_ASSETS_PER_WORLD=2

# Meshy Text-to-3D tuning (only used when MESH_PROVIDER=meshy)
MESHY_TEXT_GEOMETRY_RESOLUTION=standard
MESHY_TEXT_TEXTURE_RESOLUTION=2k
MESHY_TEXT_ENABLE_PBR=false

# ---- Filler asset provider: suggests GENERIC search keywords (rocks,
# benches, cones) from the photo+text to diversify/fill out the world ----
# mock   - suggests nothing, no key, no network (default)
# claude - Claude vision call (reuses ANTHROPIC_API_KEY above)
FILLER_ASSET_PROVIDER=mock

# Upper bound on filler assets requested per world. Each one is a single free
# library search (no generation cost), so this defaults to MAX_ASSETS_PER_WORLD
# itself -- most candidates won't survive the merge's dedup/truncation, but
# asking for enough to plausibly fill whatever room is left costs nothing.
MAX_FILLER_ASSETS_PER_WORLD=12

# ---- Library provider: turns a filler keyword into a real mesh by
# searching a public asset library, instead of generating one ----
# mock      - finds nothing; filler keywords are simply dropped (default)
# polypizza - Poly Pizza keyword search (https://poly.pizza/docs/api/v1.1),
#             free CC0/CC-BY low-poly models delivered as glTF. Get a key at
#             https://poly.pizza/settings/api
LIBRARY_PROVIDER=mock
POLYPIZZA_API_KEY=

# ---- Match picker: which Poly Pizza search result (if any) submit() uses --
# only consulted when LIBRARY_PROVIDER=polypizza ----
# claude    - one small/fast Claude (Haiku) call per keyword, given every
#             candidate's title/tags/category, to semantically pick the best
#             one or none (default). Reuses ANTHROPIC_API_KEY above; costs
#             one extra Claude call per filler keyword.
# heuristic - free, no network: scores each result's title by keyword word
#             overlap. Can't match a compound keyword like "clock_tower"
#             against a differently-worded real result like "Bell Tower" --
#             no shared words means it can only guess.
MATCH_PICKER_PROVIDER=claude

# Overall cap on the final objects[] list after photo + text + filler are all
# merged together. Hard-clamped to 12 by synthesize() regardless of this
# value, since WorldRecipe.objects' schema max_length is 12 -- raising this
# past 12 has no effect.
MAX_ASSETS_PER_WORLD=12

HOST=0.0.0.0
PORT=8000
