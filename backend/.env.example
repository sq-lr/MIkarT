# ---- Vision (VLM) provider: extracts scene info + objects from the image ----
# mock   - deterministic canned scenes, no key, no network (default)
# claude - Claude vision (claude-opus-5) via the anthropic SDK
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# ---- Mesh provider: turns each extracted object crop into a 3D model ----
# mock  - generates nothing; Unity keeps primitive placeholders (default)
# meshy - Meshy Image-to-3D (https://docs.meshy.ai/en/api/image-to-3d)
MESH_PROVIDER=mock
MESHY_API_KEY=
# model_type must be `standard` for meshy-7.1 (it rejects `lowpoly`); the
# mesh is remeshed down to MESHY_TARGET_POLYCOUNT triangles instead.
MESHY_MODEL_TYPE=standard
MESHY_SHOULD_TEXTURE=true
MESHY_TARGET_POLYCOUNT=8000

# Upper bound on objects extracted per world. Each one is a Meshy task
# (credits + minutes of generation), so keep this small.
MAX_OBJECTS_PER_WORLD=4

# ---- Text asset provider: extracts key props named in the player's TEXT
# description that the photo may not show (e.g. "a giant floating whale") ----
# mock   - extracts nothing, no key, no network (default)
# claude - Claude text-only structured output (reuses ANTHROPIC_API_KEY above)
TEXT_ASSET_PROVIDER=mock

# Upper bound on text-extracted assets per world. Each one costs TWO Meshy
# jobs (preview + refine), so keep this smaller than MAX_OBJECTS_PER_WORLD.
MAX_TEXT_ASSETS_PER_WORLD=2

# Meshy Text-to-3D tuning (only used when MESH_PROVIDER=meshy)
MESHY_TEXT_GEOMETRY_RESOLUTION=standard
MESHY_TEXT_TEXTURE_RESOLUTION=2k
MESHY_TEXT_ENABLE_PBR=false

HOST=0.0.0.0
PORT=8000
